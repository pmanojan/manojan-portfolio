# PM·OPS — EmailJS Configuration — SHIELD Dispatch
# Copy this to .env.local and fill your actual keys

# Your EmailJS Service ID — you provided: service_h9ge2zn
VITE_EMAILJS_SERVICE_ID=service_h9ge2zn

# Create a template in EmailJS dashboard using the MCU HTML from public/email-template-mcu.html
# Template should have variables: {{name}}, {{email}}, {{subject}}, {{budget}}, {{message}}, {{time}}
VITE_EMAILJS_TEMPLATE_ID=template_mcu_dispatch
# Example: template_abc123

# Public Key from EmailJS Account > General > Public Key
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE

# Optional: Auto-reply template to sender
VITE_EMAILJS_AUTO_REPLY_TEMPLATE_ID=

# Optional: OpenAI for JARVIS chatbot
VITE_OPENAI_API_KEY=sk-...
